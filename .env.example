# ── GitHub ─────────────────────────────────────────────────────────────────────
# Classic PAT with 'public_repo' scope (add 'repo' for private repos too).
# Create one at: https://github.com/settings/tokens
GITHUB_TOKEN=

# ── Gmail ──────────────────────────────────────────────────────────────────────
# Enable 2-Step Verification on your Google account, then create an App Password:
# https://myaccount.google.com/apppasswords  →  Select "Mail" → generate
GMAIL_USER=
GMAIL_APP_PASSWORD=
